# ---------------------------------------------------------
# LLM (Groq)
# ---------------------------------------------------------
# Get this from: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL_NAME="llama3-8b-8192"

# ---------------------------------------------------------
# EMBEDDINGS (Hugging Face)
# ---------------------------------------------------------
# Get this from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_your_huggingface_token_here"
HUGGINGFACE_EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# ---------------------------------------------------------
# DATABASE & VECTOR STORE (Supabase Cloud / pgvector)
# ---------------------------------------------------------
# Go to your Supabase Project Settings -> Database -> Connection String -> URI
# Make sure to replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Optional: Supabase API keys
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
SUPABASE_KEY="eyJhb_your_supabase_anon_key_here"

# ---------------------------------------------------------
# APP SETTINGS
# ---------------------------------------------------------
ENVIRONMENT="development"
DEBUG=True
