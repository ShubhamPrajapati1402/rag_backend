# ---------------------------------------------------------
# LLM (Google Gemini & Groq Multi-Tier Fallback Chain)
# ---------------------------------------------------------
# Primary Tier 1 LLM: Google Gemini
# Get this from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL_NAME="gemini-2.5-flash"

# Secondary Tier 2 Fallback LLM: Groq Qwen
# Get this from: https://console.groq.com/keys
GROQ_API_KEY="gsk_your_groq_api_key_here"
GROQ_MODEL_NAME="qwen/qwen3.8-27b"

# Tertiary Tier 3 Fallback LLM: Groq GPT-OSS
GROQ_FALLBACK_MODEL_NAME="openai/gpt-oss-120b"

# ---------------------------------------------------------
# EMBEDDINGS & RERANKING (Hugging Face)
# ---------------------------------------------------------
# Get this from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY="hf_your_huggingface_token_here"
HUGGINGFACE_EMBEDDING_MODEL="BAAI/bge-m3"
HUGGINGFACE_RERANKER_MODEL="BAAI/bge-reranker-v2-m3"
EMBEDDING_MAX_WORKERS=5
DOCUMENT_LEASE_MINUTES=30

# ---------------------------------------------------------
# DATABASE & VECTOR STORE (Supabase Cloud / pgvector)
# ---------------------------------------------------------
# Supabase Connection URI: Click "Connect" at the top of your Supabase dashboard -> "Direct Connection string" -> URI
# Make sure to replace [YOUR-PASSWORD] with your actual database password
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# Supabase URL: Found under Configuration -> API Keys (or Integrations -> Data API)
SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"

# Supabase Service Role Key: Found under Configuration -> API Keys -> "Secret keys"
SUPABASE_KEY="sb_secret_your_supabase_secret_key_here"

# Supabase JWT Secret: Found under Configuration -> JWT Keys
SUPABASE_JWT_SECRET="your_supabase_jwt_secret_here"

# ---------------------------------------------------------
# SERVER & CORS
# ---------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=2001
FRONTEND_URL="http://localhost:1001"
CORS_ORIGINS=["http://localhost:1001","http://127.0.0.1:1001"]

# ---------------------------------------------------------
# AUTHENTICATION & JWT SECURITY
# ---------------------------------------------------------
# Generate with: openssl rand -hex 32
SECRET_KEY="replace_with_a_super_secret_jwt_key_at_least_32_characters"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Primary Super Admin / System Owner Emails (Comma-separated)
# Users listed here receive permanent Super Admin status with immune revocation protection
DEVELOPER_EMAILS="scprajapati14@gmail.com"

# ---------------------------------------------------------
# COOKIE CONFIGURATION (HttpOnly Sessions)
# ---------------------------------------------------------
COOKIE_NAME="auth_token"
COOKIE_SECURE=False
COOKIE_SAMESITE="lax"
COOKIE_DOMAIN=""

# ---------------------------------------------------------
# REDIS CACHE, PUB/SUB & OTP ENGINE
# ---------------------------------------------------------
REDIS_URL="redis://localhost:6379/0"
OTP_LENGTH=6
OTP_EXPIRE_SECONDS=600

# ---------------------------------------------------------
# OTP RATE LIMITING & SECURITY RESTRICTIONS
# ---------------------------------------------------------
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_REQUESTS_PER_HOUR=5
OTP_MAX_VERIFY_ATTEMPTS=5
OTP_LOCKOUT_SECONDS=900

# ---------------------------------------------------------
# GOOGLE OAUTH
# ---------------------------------------------------------
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ---------------------------------------------------------
# EMAIL (SMTP Dispatch for OTP & Developer Invitations)
# ---------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-specific-password"
EMAILS_FROM_EMAIL="your-email@gmail.com"
EMAILS_FROM_NAME="Noesis Team"

# ---------------------------------------------------------
# APP SETTINGS & INGESTION
# ---------------------------------------------------------
ENVIRONMENT="development"
DEBUG=True
PDF_PARSING_STRATEGY="hybrid"